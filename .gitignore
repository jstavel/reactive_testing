# --- Dependencies ---
node_modules/

# --- Build output ---
dist/
build/
*.tsbuildinfo

# --- Environment ---
.env
.env.*
!.env.example

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Test output (Playwright) ---
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/
.playwright-mcp/

# --- Coverage ---
coverage/

# --- CI test-summary feed (generated by the ci job's vitest JSON step; never committed) ---
# Anchored to the repo root (/) so same-named files in nested directories are
# never hidden from git.
/vitest-summary.json
/tests.json

# --- Reactive Testing runtime evidence (generated, not checked in) ---
# corpus/* re-includes the immediate children; the ! negations un-ignore only
# the committed mock fixture subtree (spec-report-gherkin-corpus-links story
# 2). A negation cannot rescue a path under an excluded parent dir, so the
# snapshots/probes kind dirs are themselves re-included and their other
# children re-ignored — real recorded runs and their evidence stay ignored.
corpus/*
!corpus/example/
!corpus/snapshots/
corpus/snapshots/*
!corpus/snapshots/example/
!corpus/probes/
corpus/probes/*
!corpus/probes/example/
reports/

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Editors / IDEs ---
.idea/
.vscode/
*.swp
*~
\#*#
.aider*

# --- BMAD harness (tooling) ---
.agents/
_bmad/render/
